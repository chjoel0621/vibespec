  "prd": {
    "alternatives": "Today it's messenger announcements, paper sign-up sheets, and general-purpose calendars (Google Calendar) — none offer live availability or no-show management.",
    "assumptions": [
      "Every employee has a company SSO account",
      "Facilities provides the room list and capacity data",
      "No-shows can be detected as booked-but-not-checked-in"
    ],
    "category": "Internal booking management (B2B SaaS)",
    "constraints": [
      "Must work inside the corporate network (VPN)",
      "Personal data may not be stored externally per company policy",
      "iOS, Android, and web must be supported simultaneously"
    ],
    "differentiator": "Combines company SSO accounts with room availability to support instant booking of free rooms and automatic no-show tracking.",
    "goal": "Within 6 months of launch, move 80% of internal room bookings into the app and cut the no-show rate below 5%.",
    "inScope": [
      "Live room availability",
      "Create, change, and cancel bookings",
      "Confirmation and reminder notifications",
      "Admin usage-analytics dashboard"
    ],
    "kpis": [
      {
        "name": "Average taps to complete a booking",
        "refs": [
          "F3",
          "F6"
        ],
        "baseline": "6",
        "method": "Average taps to the completion event from logs",
        "target": "≤ 3"
      },
      {
        "name": "Monthly no-show rate",
        "refs": [
          "F7"
        ],
        "baseline": "18%",
        "method": "Bookings without check-in / total bookings",
        "target": "≤ 5%"
      },
      {
        "name": "Weekly active booker ratio (WAU/employees)",
        "refs": [
          "F3"
        ],
        "baseline": "22%",
        "method": "Weekly bookers / all employees",
        "target": "≥ 40%"
      }
    ],
    "nonGoals": [
      "External guest booking",
      "Payments and settlement",
      "Video-conferencing integration (excluded initially)",
      "Desk (seat) booking"
    ],
    "northStar": "Weekly Completed Bookings",
    "oneLiner": "An app where employees find and book a free meeting room in three taps and see live availability.",
    "openQuestions": [
      "Check-in via QR or NFC?",
      "Should there be a no-show penalty policy?",
      "Booking slots of 15 or 30 minutes?"
    ],
    "platforms": [
      "Web",
      "iOS",
      "Android"
    ],
    "problem": "Booking status is scattered, so finding a free room is hard (the employee's job: grab an empty room right now), and double bookings and no-shows keep recurring.",
    "risks": [
      "Uncertain schedule for company SSO integration",
      "Accuracy of availability in rooms without sensors",
      "Low statistical confidence early on due to sparse data"
    ],
    "scenarios": [
      {
        "start": "P6",
        "text": "Employee A checks free rooms from Home for a 2 p.m. meeting, picks a 3rd-floor room, adds four attendees, and confirms the booking. A confirmation notification goes out to the attendees."
      },
      {
        "start": "",
        "text": "Admin B reviews per-room utilization and no-show rates on the weekly dashboard and adjusts the operating hours of under-used rooms."
      }
    ],
    "solution": "Fast booking on top of live availability, confirmation and reminder notifications, and a usage-analytics dashboard for admins.",
    "targets": [
      {
        "name": "Employee A",
        "needs": "Grab a free meeting room quickly, right now",
        "pain": "Status is scattered, so finding an empty room is a chore",
        "role": "Booker"
      },
      {
        "name": "Team lead",
        "needs": "Share time and place with attendees in one step",
        "pain": "Verbal or chat announcements cause people to be missed",
        "role": "Attendee management"
      },
      {
        "name": "Facilities admin",
        "needs": "Manage utilization and no-shows with data",
        "pain": "No data to base operational decisions on",
        "role": "Room operations"
      }
    ],
    "whyNow": "Hybrid work concentrates demand for meeting rooms, yet bookings still happen over chat or word of mouth — double bookings and no-shows are rising, and the need for space-utilization data keeps growing."
  },
