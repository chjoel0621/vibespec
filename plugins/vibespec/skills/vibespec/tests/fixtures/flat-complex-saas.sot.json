  "prd": {
    "oneLiner": "A multi-stage planning workspace for product teams",
    "goal": "Coordinate planning, review, release, and governance",
    "whyNow": "Disconnected documents make change impact hard to understand",
    "category": "Product planning SaaS",
    "platforms": ["Web"],
    "problem": "Product teams cannot trace planning changes across delivery stages",
    "solution": "Keep planning, review, release, and governance in one structured workspace",
    "alternatives": "Documents and issue trackers",
    "differentiator": "A connected planning graph with deterministic validation",
    "targets": [{ "name": "Product team", "role": "Planner", "needs": "Traceable decisions", "pain": "Scattered planning context" }],
    "scenarios": [{ "text": "A planner creates a plan and moves it through review and release", "start": "P1" }],
    "northStar": "Approved plans delivered without missing context",
    "kpis": [{ "name": "Traceable change rate", "target": "95%", "baseline": "40%", "method": "Change receipts", "refs": ["F1"] }],
    "inScope": ["Planning", "Review", "Release", "Governance"],
    "nonGoals": ["Source-code implementation"],
    "assumptions": ["Teams use stable identifiers"],
    "risks": ["A large plan may become difficult to navigate"],
    "openQuestions": [],
    "constraints": ["JSON remains the source of truth"]
  },
  "requirements": [
