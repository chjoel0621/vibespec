      { "id": "F2", "title": "Import plan", "desc": "Import an existing structured plan", "status": "todo", "priority": "high", "acceptance": [{ "text": "A valid plan can be imported", "done": false }], "specs": [] }
    ] },
    { "id": "R2", "title": "Review", "desc": "Review proposed changes", "status": "todo", "priority": "high", "acceptance": [{ "text": "Reviewers can inspect every change", "done": false }], "features": [
